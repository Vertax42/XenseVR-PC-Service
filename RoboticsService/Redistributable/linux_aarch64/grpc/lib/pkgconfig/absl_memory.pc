prefix=/tmp/grpc-arm64-install
exec_prefix=${prefix}
libdir=/tmp/grpc-arm64-install/lib
includedir=/tmp/grpc-arm64-install/include

Name: absl_memory
Description: Abseil memory library
URL: https://abseil.io/
Version: 20240116
Requires: absl_core_headers = 20240116, absl_meta = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
