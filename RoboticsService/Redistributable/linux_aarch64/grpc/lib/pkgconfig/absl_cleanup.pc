prefix=/tmp/grpc-arm64-install
exec_prefix=${prefix}
libdir=/tmp/grpc-arm64-install/lib
includedir=/tmp/grpc-arm64-install/include

Name: absl_cleanup
Description: Abseil cleanup library
URL: https://abseil.io/
Version: 20240116
Requires: absl_cleanup_internal = 20240116, absl_config = 20240116, absl_core_headers = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
