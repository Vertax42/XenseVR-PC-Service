prefix=/tmp/grpc-arm64-install
exec_prefix=${prefix}
libdir=/tmp/grpc-arm64-install/lib
includedir=/tmp/grpc-arm64-install/include

Name: absl_bind_front
Description: Abseil bind_front library
URL: https://abseil.io/
Version: 20240116
Requires: absl_base_internal = 20240116, absl_compressed_tuple = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
