prefix=/tmp/grpc-arm64-install
exec_prefix=${prefix}
libdir=/tmp/grpc-arm64-install/lib
includedir=/tmp/grpc-arm64-install/include

Name: absl_random_internal_distribution_caller
Description: Abseil random_internal_distribution_caller library
URL: https://abseil.io/
Version: 20240116
Requires: absl_config = 20240116, absl_utility = 20240116, absl_fast_type_id = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
