prefix=/tmp/grpc-arm64-install
exec_prefix=${prefix}
libdir=/tmp/grpc-arm64-install/lib
includedir=/tmp/grpc-arm64-install/include

Name: absl_int128
Description: Abseil int128 library
URL: https://abseil.io/
Version: 20240116
Requires: absl_config = 20240116, absl_core_headers = 20240116, absl_bits = 20240116
Libs: -L${libdir}  -labsl_int128 
Cflags: -I${includedir} -DNOMINMAX
