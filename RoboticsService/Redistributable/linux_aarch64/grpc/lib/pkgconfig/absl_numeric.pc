prefix=/tmp/grpc-arm64-install
exec_prefix=${prefix}
libdir=/tmp/grpc-arm64-install/lib
includedir=/tmp/grpc-arm64-install/include

Name: absl_numeric
Description: Abseil numeric library
URL: https://abseil.io/
Version: 20240116
Requires: absl_int128 = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
