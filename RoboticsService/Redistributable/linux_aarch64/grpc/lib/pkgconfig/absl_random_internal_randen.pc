Requires: absl_random_internal_platform = 20240116, absl_random_internal_randen_hwaes = 20240116, absl_random_internal_randen_slow = 20240116
Libs: -L${libdir}  -labsl_random_internal_randen 
Cflags: -I${includedir} -DNOMINMAX
