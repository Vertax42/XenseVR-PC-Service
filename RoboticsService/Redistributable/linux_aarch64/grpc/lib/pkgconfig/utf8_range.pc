prefix=/tmp/grpc-arm64-install
exec_prefix=/tmp/grpc-arm64-install
libdir=/tmp/grpc-arm64-install/lib
includedir=/tmp/grpc-arm64-install/include

Name: UTF8 Range
Description: Google's UTF8 Library
Version: 1.0
Requires: absl_strings
Libs: -L${libdir} -lutf8_validity -lutf8_range 
Cflags: -I${includedir}
