prefix=/tmp/grpc-arm64-install
exec_prefix=${prefix}
libdir=/tmp/grpc-arm64-install/lib
includedir=/tmp/grpc-arm64-install/include

Name: absl_time_zone
Description: Abseil time_zone library
URL: https://abseil.io/
Version: 20240116
Requires:
Libs: -L${libdir}  -labsl_time_zone 
Cflags: -I${includedir} -DNOMINMAX
