prefix=/tmp/grpc-arm64-install
exec_prefix=${prefix}
libdir=/tmp/grpc-arm64-install/lib
includedir=/tmp/grpc-arm64-install/include

Name: absl_cordz_statistics
Description: Abseil cordz_statistics library
URL: https://abseil.io/
Version: 20240116
Requires: absl_config = 20240116, absl_core_headers = 20240116, absl_cordz_update_tracker = 20240116, absl_synchronization = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
