prefix=/tmp/grpc-arm64-install
exec_prefix=${prefix}
libdir=/tmp/grpc-arm64-install/lib
includedir=/tmp/grpc-arm64-install/include

Name: absl_log_internal_strip
Description: Abseil log_internal_strip library
URL: https://abseil.io/
Version: 20240116
Requires: absl_log_internal_message = 20240116, absl_log_internal_nullstream = 20240116, absl_log_severity = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
