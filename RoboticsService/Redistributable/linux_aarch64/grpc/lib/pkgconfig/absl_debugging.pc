prefix=/tmp/grpc-arm64-install
exec_prefix=${prefix}
libdir=/tmp/grpc-arm64-install/lib
includedir=/tmp/grpc-arm64-install/include

Name: absl_debugging
Description: Abseil debugging library
URL: https://abseil.io/
Version: 20240116
Requires: absl_stacktrace = 20240116, absl_leak_check = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
